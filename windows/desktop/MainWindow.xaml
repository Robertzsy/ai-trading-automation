<Window x:Class="AiTradingAutomation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Trading Automation"
        Width="1420" Height="900"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Background="#0B0E14" Foreground="#CBD5E1" BorderBrush="#273044" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock x:Name="AgentStatusText" Text="" Margin="0,0,16,0" />
                    <TextBlock x:Name="ChatStatusText" Text="" Margin="0,0,16,0" />
                    <TextBlock x:Name="HarnessText" Text="" Margin="0,0,16,0" />
                    <TextBlock x:Name="ModeText" Text="" Margin="0,0,16,0" />
                    <TextBlock x:Name="MandateText" Text="" Margin="0,0,16,0" />
                    <TextBlock x:Name="RoundText" Text="" Margin="0,0,16,0" />
                </WrapPanel>
            </StatusBarItem>
        </StatusBar>
        <wv2:WebView2 x:Name="WebView" />
    </DockPanel>
</Window>
