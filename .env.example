# ===== LLM API Keys (fill locally; never commit .env) =====
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
FINNHUB_API_KEY=

# ===== Screening database (OPTIONAL) =====
# LEAVE THIS EMPTY -- that is the recommended configuration and the default.
# With no URI and screening.storage.backend: auto, screening results are stored
# as local JSON files under runtime/. Full functionality, no extra service, no
# startup delay, no log noise. You do not need Docker or MongoDB.
#
# Set it only if you have deployed MongoDB yourself (e.g. a container mapped to
# 27018) and want the extra queryable history; the port must match the mapping:
#     MONGODB_URI=mongodb://127.0.0.1:27018
# If a configured server later becomes unreachable, screening automatically
# falls back to JSON after a short wait and logs one warning.
# To force JSON-only even when a URI is set, put this in config/config.yaml:
#     screening.storage.backend: json
MONGODB_URI=

# ===== Runtime overrides =====
LLM_PROVIDER=deepseek
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO
NOTIFY_WEBHOOK_URL=
# Optional external macro source; normally the bundled collector writes runtime/macro.
MACRO_SOURCE_DIR=
# Optional declared SEC app identity (not an API Key). A project URL is used by default.
IA_SEC_USER_AGENT=
